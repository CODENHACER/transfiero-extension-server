{
  "manifest_version": 3,
  "name": "TRANSFIERO",
  "version": "1.0.0",
  "description": "Envía archivos entre tu PC y tu móvil Android o iOS de forma cifrada, sin cables ni instalar apps.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TRANSFIERO",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "minimum_chrome_version": "116",
  "permissions": []
}
